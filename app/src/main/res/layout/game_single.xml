<?xml version="1.0" encoding="utf-8"?>
<!--
  人机对局：记分卡 → 棋盘 → 对手设置 → 终局横幅 → 主次按钮。
  棋盘是整屏唯一有材质的东西（木色 + 圆角），其余全部让位。
  布局顺序固定：横幅插在棋盘之后，终局时按钮下移，棋盘不跳。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_l"
        android:paddingEnd="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_l">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@android:color/transparent"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp"
            app:navigationIcon="@drawable/bg_nav_back"
            app:title="@string/new_game"
            app:titleCentered="true"
            app:titleTextColor="?attr/colorOnSurface" />

        <!-- ===== 记分卡 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="@dimen/spacing_m"
                android:paddingBottom="@dimen/spacing_m">

                <!-- 左：自己（执黑先手） -->
                <LinearLayout
                    android:id="@+id/black_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/stone_size"
                        android:layout_height="@dimen/stone_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/black_chess" />

                    <TextView
                        android:id="@+id/black_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:text="@string/myself"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <!-- 朱砂点 = 轮到他落子 -->
                    <ImageView
                        android:id="@+id/black_active"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:importantForAccessibility="no"
                        android:src="@drawable/active_dot" />

                    <TextView
                        android:id="@+id/black_win"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.Gomoku.Score"
                        tools:text="0" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="@string/score_colon"
                    android:textColor="?attr/colorOutline"
                    android:textSize="18sp" />

                <!-- 右：电脑（执白） -->
                <LinearLayout
                    android:id="@+id/white_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/white_win"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:textAppearance="@style/TextAppearance.Gomoku.Score"
                        tools:text="0" />

                    <ImageView
                        android:id="@+id/white_active"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="@dimen/spacing_s"
                        android:importantForAccessibility="no"
                        android:src="@drawable/active_dot" />

                    <TextView
                        android:id="@+id/white_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_s"
                        android:text="@string/computer"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <ImageView
                        android:id="@+id/white_chess"
                        android:layout_width="@dimen/stone_size"
                        android:layout_height="@dimen/stone_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/white_chess" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 棋盘 =====
             木框留 6dp，圆角由 GameBoardView 自己按 board_inner_radius 裁，
             SurfaceView 在独立层，卡片的圆角裁不到它。 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            app:cardBackgroundColor="@color/board_frame"
            app:cardCornerRadius="@dimen/board_corner_radius"
            app:cardElevation="0dp"
            app:contentPadding="@dimen/board_frame_padding"
            app:strokeWidth="0dp">

            <com.github.lany192.gomoku.ui.common.GameBoardView
                android:id="@+id/game_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 对手设置入口 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/opponent_settings"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="@dimen/spacing_m"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:rippleColor="?attr/colorControlHighlight"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_box">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_tune" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ai_select_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/opponent_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp"
                        tools:text="算法：Alpha-Beta 剪枝 · 难度：困难" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOutline" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 终局横幅 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/result_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:visibility="gone"
            app:cardBackgroundColor="@color/accent_container"
            app:cardCornerRadius="@dimen/radius_button"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/result_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/spacing_m"
                android:textColor="@color/on_accent_container"
                android:textSize="15sp"
                tools:text="黑方胜！" />
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 操作：一屏只留一个主按钮 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rollback"
                style="@style/Widget.Gomoku.Button.Ghost"
                android:layout_width="104dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="10dp"
                android:text="@string/rollback" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/restart"
                style="@style/Widget.Gomoku.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="@string/restart" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
