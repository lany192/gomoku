<?xml version="1.0" encoding="utf-8"?>
<!--
  两人对战（同屏）：与人机对局同一套骨架，黑白双方都是真人，多一个回合计时器。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_l"
        android:paddingEnd="@dimen/spacing_l"
        android:paddingBottom="@dimen/spacing_l">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@android:color/transparent"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp"
            app:navigationIcon="@drawable/bg_nav_back"
            app:title="@string/fight"
            app:titleCentered="true"
            app:titleTextColor="?attr/colorOnSurface" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="@dimen/radius_card"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="@dimen/spacing_m"
                android:paddingBottom="@dimen/spacing_m">

                <LinearLayout
                    android:id="@+id/black_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/stone_size"
                        android:layout_height="@dimen/stone_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/black_chess" />

                    <TextView
                        android:id="@+id/black_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:text="@string/black"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <ImageView
                        android:id="@+id/black_active"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:importantForAccessibility="no"
                        android:src="@drawable/active_dot" />

                    <TextView
                        android:id="@+id/black_win"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.Gomoku.Score"
                        tools:text="0" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="@string/score_colon"
                    android:textColor="?attr/colorOutline"
                    android:textSize="18sp" />

                <LinearLayout
                    android:id="@+id/white_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/white_win"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:textAppearance="@style/TextAppearance.Gomoku.Score"
                        tools:text="0" />

                    <ImageView
                        android:id="@+id/white_active"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="@dimen/spacing_s"
                        android:importantForAccessibility="no"
                        android:src="@drawable/active_dot" />

                    <TextView
                        android:id="@+id/white_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_s"
                        android:text="@string/white"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <ImageView
                        android:id="@+id/white_chess"
                        android:layout_width="@dimen/stone_size"
                        android:layout_height="@dimen/stone_size"
                        android:importantForAccessibility="no"
                        android:src="@drawable/white_chess" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 回合计时器 -->
        <TextView
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_timer_pill"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="@string/countdown_idle"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            app:cardBackgroundColor="@color/board_frame"
            app:cardCornerRadius="@dimen/board_corner_radius"
            app:cardElevation="0dp"
            app:contentPadding="@dimen/board_frame_padding"
            app:strokeWidth="0dp">

            <com.github.lany192.gomoku.ui.common.GameBoardView
                android:id="@+id/game_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/result_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:visibility="gone"
            app:cardBackgroundColor="@color/accent_container"
            app:cardCornerRadius="@dimen/radius_button"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/result_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/spacing_m"
                android:textColor="@color/on_accent_container"
                android:textSize="15sp"
                tools:text="黑方胜！" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rollback"
                style="@style/Widget.Gomoku.Button.Ghost"
                android:layout_width="104dp"
                android:layout_height="@dimen/button_height"
                android:layout_marginEnd="10dp"
                android:text="@string/rollback" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/restart"
                style="@style/Widget.Gomoku.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:layout_weight="1"
                android:text="@string/restart" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
