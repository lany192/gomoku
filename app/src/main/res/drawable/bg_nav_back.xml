<?xml version="1.0" encoding="utf-8"?>
<!--
  返回按钮：圆底 + 箭头合成一张图，直接给 MaterialToolbar 当 navigationIcon。
  用 @color/surface 而不是 ?attr/colorSurface —— drawable 里取主题属性的兼容性不稳，
  而 surface 在 values / values-night 都定义过，会自动跟随深浅主题。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="40dp"
        android:height="40dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/surface" />
            <stroke
                android:width="1dp"
                android:color="@color/outline_variant" />
        </shape>
    </item>
    <item
        android:width="18dp"
        android:height="18dp"
        android:drawable="@drawable/ic_arrow_left"
        android:gravity="center" />
</layer-list>
